{
  "name": "portal-rrhh",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:api\" \"npm:web\"",
    "api": "node --watch backend/server/index.js",
    "web": "vite frontend --host 127.0.0.1 --configLoader runner",
    "build": "vite build frontend --configLoader runner",
    "migrate": "node backend/scripts/migrate.js",
    "seed": "node backend/scripts/seed.js",
    "seed:users": "node backend/scripts/seed-users.js",
    "ingest": "node backend/scripts/ingest.js",
    "test": "node --test",
    "test:integration": "node --test backend/integration/portal.integration.js",
    "seed:fixture": "node backend/scripts/seed-fixture.js",
    "seed:history": "node backend/scripts/seed-history.js",
    "evaluate": "node backend/scripts/evaluate.js",
    "drive:check": "node backend/scripts/check-drive.js",
    "evaluate:summary": "node backend/scripts/evaluation-summary.js",
    "reports:pdf": "node backend/scripts/build-reports.js",
    "reports:summary": "node backend/scripts/verify-report-summary.js",
    "evaluate:review": "node backend/scripts/review-evaluation.js",
    "seed:repair-history": "node backend/scripts/repair-demo-history.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "googleapis": "^144.0.0",
    "mammoth": "^1.13.0",
    "mysql2": "^3.15.3",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sequelize": "^6.37.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "pdfkit": "^0.20.2",
    "vite": "^6.0.5"
  }
}
